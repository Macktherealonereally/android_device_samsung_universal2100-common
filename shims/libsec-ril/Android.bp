// Wraps the Samsung RIL (renamed to libsec-ril-impl.so via FIX_SONAME) so
// GET_SMSC_ADDRESS responses reach Android as a plain E.164 number, which
// SMS over IMS needs. rild dlopen()s "libsec-ril.so" by name (no -l arg in
// vendor.samsung.rild.rc), so the shim must keep that name.
// Ported from LineageOS android_device_samsung_universal9830-common
// (lineage-24.0, libshims/libsec-ril).
cc_library_shared {
    name: "libsec-ril",
    vendor: true,
    compile_multilib: "64",
    srcs: ["main.cpp"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-DANDROID_MULTI_SIM",
        "-DANDROID_SIM_COUNT_2",
        "-DRIL_SHLIB",
        "-DREAL_LIB_NAME=\"libsec-ril-impl.so\"",
    ],
    shared_libs: [
        "libdl",
        "liblog",
        // DT_NEEDED so it is loaded (DF_1_GLOBAL) before the impl.
        "libsec-ril-slotswitch",
    ],
    include_dirs: [
        "hardware/ril/include",
    ],
}
