        <!-- VoWiFi / ePDG (values from Google CarrierSettings kpn_nl v80000000010 and
             stock HZC2 epdg_apns_conf.xml KPN_NL: AES-CBC-256, SHA2-256, MODP2048) -->
        <string name="iwlan.epdg_static_address_string">epdg.epc.mnc008.mcc204.pub.3gppnetwork.org</string>
        <int-array name="iwlan.epdg_address_priority_int_array" num="2">
            <item value="0" />
            <item value="1" />
        </int-array>
        <int-array name="iwlan.diffie_hellman_groups_int_array" num="1">
            <item value="14" />
        </int-array>
        <int name="iwlan.ike_remote_id_type_int" value="11" />
        <int name="iwlan.ike_rekey_soft_timer_sec_int" value="86400" />
        <int name="iwlan.ike_rekey_hard_timer_in_sec" value="86500" />
        <int name="iwlan.child_sa_rekey_soft_timer_sec_int" value="86400" />
        <int name="iwlan.child_sa_rekey_hard_timer_sec_int" value="86500" />
    </carrier_config>
    <!-- Lebara NL (Google carrier list) -->
    <carrier_config mcc="204" mnc="17">
        <!-- Service enablement (ImsStack's CarrierSettings deliberately leaves this to
