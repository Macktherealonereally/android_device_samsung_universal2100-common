<resources>
    <!-- Bring-up gates (see packages/modules/ImsStack/README.md). Emergency calls keep
         using CS/the modem until the emergency/fallback path has been validated. -->
    <bool name="config_imsstack_emergency_mmtel_feature">false</bool>
    <bool name="config_imsstack_rcs_feature">false</bool>

    <!-- The Samsung RIL reports no dedicated-bearer QoS ("FillQosFlowInfo: QOS is not
         supported"). Preconditions are switched off per carrier in CarrierConfig
         instead; setting this to false would also change ImsStack's config for KPN.
         See ims/carrier_config/README.md. -->
    <bool name="config_imsstack_dedicated_bearer_qos_supported">true</bool>
</resources>
