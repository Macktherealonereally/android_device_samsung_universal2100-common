// res/xml/vendor.xml is generated: edit ims/carrier_config/manual.xml or
// policy.json and run ims/carrier_config/carrier_ims.py generate.
runtime_resource_overlay {
    name: "CarrierConfigOverlayIms",
    vendor: true,
    // vendor.xml filters are compared as strings (DefaultCarrierConfigService
    // checkFilters). Without raw values aapt2 compiles mnc="08" to the integer 8,
    // which never equals CarrierIdentifier.getMnc() "08".
    aaptflags: ["--keep-raw-values"],
}
