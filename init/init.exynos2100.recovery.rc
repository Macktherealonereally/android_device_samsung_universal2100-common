on init
    write /proc/sys/kernel/hung_task_timeout_secs 0
    start watchdogd

    # unlink /efs > /mnt/vendor/efs
    rm /efs
    mkdir /efs
    mkdir /sec_efs

    # to cut charging battery path
    write /sys/class/power_supply/battery/siop_level 0

on late-init
    setprop sys.usb.controller 10e00000.usb
    setprop ro.debuggable 1
    setprop service.adb.root 1
    setprop sys.usb.configfs 1

# Recovery sets sys.usb.config itself (none/adb/sideload/fastboot), so don't
# bind the gadget here. After the core "none" action unbinds the UDC, block
# init 0.5 s so the next bind (queued behind this) comes after the host has
# seen the disconnect; a quick rebind seems to cause the PC's first
# enumeration to fail ("device not accepting address", error -71).
# `wait` on a path that never exists is just a sleep.
on property:sys.usb.config=none && property:sys.usb.configfs=1
    wait /dev/usb_settle_never_exists 0.5

# Set watchdog timer to 40 seconds and pet it every 10 seconds to get a 30 second margin
service watchdogd /system/bin/watchdogd 10 30
    class core
    oneshot
    seclabel u:r:watchdogd:s0
